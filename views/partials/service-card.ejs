<%-
/* ============================================================
   File Name   : service-card.ejs (partial)
   Student's Name : 徐斌航
   StudentID   : 2024110514
   Date        : 2026-11-03
   Description : Reusable Bootstrap card that displays one
                 service offered (icon + title + description).
                 Rendered once per service on the Services page.
   ============================================================ */
%>

<!-- ---------- Single service card ---------- -->
<div class="col-md-6 col-lg-4">
  <div class="card service-card h-100 text-center shadow-sm">
    <div class="card-body p-4">
      <!-- Icon representing the service -->
      <div class="service-icon mx-auto mb-3 d-flex align-items-center justify-content-center">
        <i class="bi <%= service.icon %>" aria-hidden="true"></i>
      </div>

      <!-- Service title -->
      <h3 class="h5 fw-bold"><%= service.title %></h3>

      <!-- Short service description -->
      <p class="card-text text-muted mb-0"><%= service.description %></p>
    </div>
  </div>
</div>
