   Description : Error view created by the Express Generator.
                 Rendered whenever an error (e.g. a 404) is
                 passed to the error handler in app.js.
   ============================================================ */
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Error</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="d-flex align-items-center min-vh-100 bg-light">

  <!-- ---------- Error message ---------- -->
  <main class="container text-center py-5">
    <h1 class="display-1 fw-bold text-danger"><%= error.status || 500 %></h1>
    <h2 class="mb-4">Oops! Something went wrong.</h2>
    <p class="lead text-muted"><%= message %></p>
    <a href="/" class="btn btn-dark btn-lg mt-3">
      <i class="bi bi-house-fill me-2"></i>Back to Home
    </a>
  </main>

</body>
</html>
